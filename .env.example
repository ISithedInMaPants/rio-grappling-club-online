# Rio Grappling Club Online Environment Configuration

# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID="your-sanity-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"

# Mux Video Infrastructure
# Note: For public playback in the client, Mux Playback IDs are used.
# Secret tokens are used for server-side uploads or asset management.
MUX_TOKEN_ID="your-mux-token-id"
MUX_TOKEN_SECRET="your-mux-token-secret"

# Public site deployment URL
NEXT_PUBLIC_SITE_URL="https://rio-grappling-club-online.vercel.app"
